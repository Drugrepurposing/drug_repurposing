# Copy this file to .env.local and adjust if your backend runs elsewhere.
# .env.local is git-ignored; this example file is committed as documentation.
VITE_API_URL=http://localhost:8000

# Full-screen background. The image ships with the repository; replace
# public/backdrop.jpg with your own photograph to change it.
VITE_BACKDROP_IMAGE=/backdrop.jpg

# Leave empty for a still image. Set to /backdrop.mp4 once you have added a
# video to public/ and the background becomes a silent looping video, with the
# image above used as its poster frame.
VITE_BACKDROP_VIDEO=
