# Copy this file to backend/.env and fill in the values:
#
#   Copy-Item .env.example .env     (Windows PowerShell)
#   cp .env.example .env            (macOS / Linux)
#
# .env is git-ignored; this example is committed as documentation of the keys.
# The backend reads it automatically at startup, so every terminal you launch
# the server from picks these up — there is no need to export them by hand.
#
# A real environment variable always overrides this file. That is how
# deployment stays correct: Render sets these in the process environment and no
# .env file exists there, so this can never shadow production configuration.

# PostgreSQL connection string.
#
# Leave it UNSET and the application still runs — search, docking, the 3D
# viewer and the PDF export all work, you simply cannot log in or store
# history. That is deliberate, so nobody is blocked waiting for credentials.
#
# Local development, using docker-compose.yml at the repository root:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/drugrepurposing
#
# Production (Neon): use the POOLED connection string, the one with "-pooler"
# in the hostname. Pooling matters because the backend can restart or run more
# than one instance, and each would otherwise open its own connections.
DATABASE_URL=

# Signing key for access tokens. Anyone holding it can forge a token for any
# account, so treat it exactly like the database password: it belongs here or
# in the hosting provider's secret settings, never in committed code.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# If unset, a random key is generated at startup and every restart signs
# everyone out. Acceptable locally; not acceptable in deployment.
JWT_SECRET=

# How long a session lasts before the user must sign in again.
# Defaults to 10080 minutes (7 days).
# JWT_EXPIRE_MINUTES=10080

# Comma-separated list of frontend origins allowed to call this API.
# Left commented out it means "*", which is fine locally and wrong in
# production. Uncomment and set it to your deployed frontend URL there.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Set to DEBUG for far more detail when something is not behaving.
# LOG_LEVEL=INFO
